{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "0",
        "model": {
          "type": "minecraft:model",
          "model": "finsandtails:item/blu_wee_bucket"
        }
      },
      {
        "when": "1",
        "model": {
          "type": "minecraft:model",
          "model": "finsandtails:item/pea_wee_bucket"
        }
      },
      {
        "when": "2",
        "model": {
          "type": "minecraft:model",
          "model": "finsandtails:item/muck_wee_bucket"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "finsandtails:item/blu_wee_bucket"
    }
  }
}
